{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesswhy.local/schema/report.v2.schema.json",
  "title": "ChessWhy report, schema version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input", "engine", "position", "threats", "candidates", "fine_truncated", "asked_move", "opening"],
  "properties": {
    "schema_version": {"const": 2},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fen", "pgn_game", "pgn_ply", "move", "level", "budget"],
      "properties": {
        "source": {"enum": ["fen", "pgn"]},
        "fen": {"type": "string"},
        "pgn_game": {"type": ["integer", "null"], "minimum": 1},
        "pgn_ply": {"type": ["integer", "null"], "minimum": 0},
        "move": {"type": ["string", "null"]},
        "level": {"enum": ["beginner", "club", "advanced"]},
        "budget": {"enum": ["quick", "standard", "deep"]}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "threads", "hash_mb", "multipv", "reproducible", "nodes", "nodes_searched"],
      "properties": {
        "name": {"type": "string"},
        "threads": {"type": "integer", "minimum": 1},
        "hash_mb": {"type": "integer", "minimum": 1},
        "multipv": {"type": "integer", "minimum": 1},
        "reproducible": {"type": "boolean"},
        "nodes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C", "D", "E"],
          "properties": {
            "A": {"type": "integer", "minimum": 1},
            "B": {"type": "integer", "minimum": 1},
            "C": {"type": "integer", "minimum": 1},
            "D": {"type": "integer", "minimum": 1},
            "E": {"type": "integer", "minimum": 1}
          }
        },
        "nodes_searched": {"type": "integer", "minimum": 0}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fen", "side_to_move", "in_check", "terminal", "eval_white", "motifs"],
      "properties": {
        "fen": {"type": "string"},
        "side_to_move": {"$ref": "#/$defs/side"},
        "in_check": {"type": "boolean"},
        "terminal": {"enum": ["checkmate", "stalemate", null]},
        "eval_white": {"oneOf": [{"$ref": "#/$defs/eval"}, {"type": "null"}]},
        "motifs": {"$ref": "#/$defs/motifs"}
      }
    },
    "threats": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["white", "black", "null_move_reliable", "urgency"],
          "properties": {
            "white": {"oneOf": [{"$ref": "#/$defs/threat"}, {"type": "null"}]},
            "black": {"oneOf": [{"$ref": "#/$defs/threat"}, {"type": "null"}]},
            "null_move_reliable": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "value"],
              "properties": {
                "source": {"const": "rule"},
                "value": {"type": ["boolean", "null"]}
              }
            },
            "urgency": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "more_urgent", "rule"],
              "properties": {
                "source": {"const": "rule"},
                "more_urgent": {"oneOf": [{"$ref": "#/$defs/side"}, {"type": "null"}]},
                "rule": {"enum": ["in_check", "quiet", "consequence_class", "counterattack", "parry"]}
              }
            }
          }
        }
      ]
    },
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/move"}},
    "fine_truncated": {"type": "boolean"},
    "asked_move": {"oneOf": [{"$ref": "#/$defs/move"}, {"type": "null"}]},
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "dataset", "current", "last_named"],
      "properties": {
        "source": {"const": "book"},
        "dataset": {"type": "string"},
        "current": {"oneOf": [{"$ref": "#/$defs/opening_name"}, {"type": "null"}]},
        "last_named": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["eco", "name", "ply"],
              "properties": {
                "eco": {"$ref": "#/$defs/eco"},
                "name": {"type": "string"},
                "ply": {"type": "integer", "minimum": 1}
              }
            },
            {"type": "null"}
          ]
        }
      }
    }
  },
  "$defs": {
    "side": {"enum": ["white", "black"]},
    "eco": {"type": "string", "pattern": "^[A-E][0-9]{2}$"},
    "opening_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eco", "name"],
      "properties": {"eco": {"$ref": "#/$defs/eco"}, "name": {"type": "string"}}
    },
    "san_line": {"type": "array", "items": {"type": "string"}, "maxItems": 10},
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "es", "cp", "mate"],
      "properties": {
        "source": {"const": "engine"},
        "es": {"type": "number", "minimum": 0, "maximum": 1},
        "cp": {"type": ["integer", "null"]},
        "mate": {"type": ["integer", "null"]}
      }
    },
    "consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "class", "mate_in", "material", "promotes", "plies"],
      "properties": {
        "source": {"const": "rule"},
        "class": {"enum": ["mate", "material", "promotion", "positional"]},
        "mate_in": {"type": ["integer", "null"], "minimum": 1},
        "material": {"type": "integer"},
        "promotes": {"type": "boolean"},
        "plies": {"type": "integer", "minimum": 0}
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "side", "root_fen", "line", "consequence", "motifs"],
      "properties": {
        "source": {"const": "engine"},
        "side": {"$ref": "#/$defs/side"},
        "root_fen": {"type": "string"},
        "line": {"$ref": "#/$defs/san_line"},
        "consequence": {"$ref": "#/$defs/consequence"},
        "motifs": {"$ref": "#/$defs/motifs"}
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "san", "uci", "eval", "loss", "verdict", "in_multipv", "gives_check", "line", "parries_threat", "creates_threat", "refutation", "motifs"],
      "properties": {
        "source": {"const": "engine"},
        "san": {"type": "string"},
        "uci": {"type": "string", "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"},
        "eval": {"$ref": "#/$defs/eval"},
        "loss": {"type": "number", "minimum": 0, "maximum": 1},
        "verdict": {"enum": ["fine", "inaccuracy", "mistake", "blunder"]},
        "in_multipv": {"type": "boolean"},
        "gives_check": {"type": "boolean"},
        "line": {"$ref": "#/$defs/san_line"},
        "parries_threat": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "value", "test"],
              "properties": {
                "source": {"enum": ["engine", "rule"]},
                "value": {"type": "boolean"},
                "test": {"enum": ["searched", "threat_move_illegal", "deferred_by_check"]}
              }
            },
            {"type": "null"}
          ]
        },
        "creates_threat": {"oneOf": [{"$ref": "#/$defs/threat"}, {"type": "null"}]},
        "refutation": {"oneOf": [{"$ref": "#/$defs/threat"}, {"type": "null"}]},
        "motifs": {"$ref": "#/$defs/motifs"}
      }
    },
    "piece_on_square": {
      "type": "object",
      "additionalProperties": false,
      "required": ["square", "piece"],
      "properties": {
        "square": {"type": "string", "pattern": "^[a-h][1-8]$"},
        "piece": {"type": "string", "pattern": "^[PNBRQKpnbrqk]$"}
      }
    },
    "motif": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "tag", "side", "ply", "actor", "targets", "gain"],
      "properties": {
        "source": {"const": "rule"},
        "tag": {"enum": ["hanging_piece", "pin_absolute", "pin_relative", "back_rank_weakness",
                         "overloaded_defender", "trapped_piece", "fork", "skewer", "discovered_check",
                         "discovered_attack", "double_check", "back_rank_mate", "removal_of_defender",
                         "promotion"]},
        "side": {"$ref": "#/$defs/side"},
        "ply": {"type": "integer", "minimum": 0},
        "actor": {"$ref": "#/$defs/piece_on_square"},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/piece_on_square"}},
        "gain": {"type": ["integer", "null"], "minimum": 1}
      },
      "if": {"properties": {"tag": {"enum": ["hanging_piece", "trapped_piece"]}}},
      "then": {"properties": {"gain": {"type": "integer"}}},
      "else": {"properties": {"gain": {"type": "null"}}}
    },
    "motifs": {"type": "array", "items": {"$ref": "#/$defs/motif"}}
  }
}
