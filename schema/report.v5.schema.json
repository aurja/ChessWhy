            "exchange_up"
          ]
        },
        "side": {
          "description": "Side that owns the positional feature [rule].",
          "$ref": "#/$defs/side"
        },
        "pieces": {
          "description": "Pieces describing the feature, in the tag-specific order [rule].",
          "type": "array",
          "items": {
            "$ref": "#/$defs/piece_on_square"
          }
        },
        "file": {
          "description": "File associated with the feature, or null when it has no file [rule].",
          "oneOf": [
