    "games": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "by_source"
      ],
      "properties": {
        "source": {
          "description": "Provenance of the game-count results [games].",
          "const": "games"
        },
        "by_source": {
          "description": "Game-count results for each configured source [games].",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/game_source"
          }
        }
      }
    },
    "game_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "table",
        "platform",
        "players",
        "months",
        "credit",
        "max_ply",
        "min_games",
        "found",
        "games",
        "white",
        "draws",
        "black",
        "moves"
      ],
      "properties": {
        "id": {
          "description": "Identifier of the games source [games].",
          "type": "string"
        },
        "table": {
          "description": "Shipped games-table ID or custom@ plus the first 12 SHA-256 hex digits [games].",
          "type": "string",
          "pattern": "^(lichess_broadcast_2200@e0cb7fab3212|custom@[0-9a-f]{12})$"
        },
        "platform": {
          "description": "Platform represented by the source's table [games].",
          "type": "string"
        },
        "players": {
          "description": "Player rating criterion represented by the source's table [games].",
          "type": "string"
        },
        "months": {
          "description": "Date range represented by the source's table [games].",
          "type": "string"
        },
        "credit": {
          "description": "Credit and license information for the source data [games].",
          "type": "string"
        },
        "max_ply": {
          "description": "Maximum searched half-move count in the source's table [games].",
          "type": "integer",
          "minimum": 1
        },
        "min_games": {
          "description": "Minimum game count required for a move to be listed [games].",
          "type": "integer",
          "minimum": 1
        },
        "found": {
          "description": "Whether the analyzed position was found in the source table [games].",
          "type": "boolean"
        },
        "games": {
          "description": "Total games for the position, or null iff it was not found [games].",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "white": {
          "description": "White wins for the position, or null iff it was not found [games].",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "draws": {
          "description": "Draws for the position, or null iff it was not found [games].",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "black": {
          "description": "Black wins for the position, or null iff it was not found [games].",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "moves": {
          "description": "Moves from the analyzed position and their game counts [games].",
          "type": "array",
          "items": {
            "$ref": "#/$defs/game_move"
          }
        }
      },
      "if": {
        "properties": {
          "found": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "games": {
            "type": "null"
          },
          "white": {
            "type": "null"
          },
          "draws": {
            "type": "null"
          },
          "black": {
            "type": "null"
          },
          "moves": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "games": {
            "type": "integer",
            "minimum": 1
          },
          "white": {
            "type": "integer"
          },
          "draws": {
            "type": "integer"
          },
          "black": {
            "type": "integer"
          },
          "moves": {
            "minItems": 1
          }
        }
      }
    },
    "game_move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "san",
        "uci",
        "games"
      ],
      "properties": {
        "san": {
          "description": "Standard algebraic notation of the move from the analyzed position [games].",
          "type": "string"
        },
        "uci": {
          "description": "UCI encoding of the move from the analyzed position [games].",
          "type": "string",
          "pattern": "^[a-h][1-8][a-h][1-8][nbrq]?$"
        },
        "games": {
          "description": "Number of source games that played this move [games].",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
