        },
        "change": {
          "description": "Whether the feature appears on P_k or disappears from P_k-1 [rule].",
          "enum": [
            "appears",
            "disappears"
          ]
        },
        "holds_at_end": {
          "description": "Whether the feature still holds at the end of the line [rule].",
          "type": "boolean"
        },
        "tag": {
          "description": "Tag of the positional feature that changed [rule].",
          "enum": [
            "isolated_pawn",
            "doubled_pawns",
            "tripled_pawns",
            "backward_pawn",
            "passed_pawn",
            "connected_passed_pawns",
            "pawn_islands",
            "pawn_chain",
            "castling_kingside",
