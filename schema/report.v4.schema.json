{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chesswhy.local/schema/report.v4.schema.json",
  "title": "ChessWhy report, schema version 4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input",
    "engine",
    "position",
    "threats",
    "candidates",
    "fine_truncated",
    "asked_move",
    "opening",
    "games"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "fen",
        "pgn_game",
        "pgn_ply",
        "move",
        "level",
        "budget"
      ],
      "properties": {
        "source": {
          "enum": [
            "fen",
            "pgn"
          ]
        },
        "fen": {
          "type": "string"
        },
        "pgn_game": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "pgn_ply": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "move": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "enum": [
            "beginner",
            "club",
            "advanced"
          ]
        },
        "budget": {
          "enum": [
            "quick",
            "standard",
            "deep"
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "threads",
        "hash_mb",
        "multipv",
        "reproducible",
        "nodes",
        "nodes_searched"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "hash_mb": {
          "type": "integer",
          "minimum": 1
        },
        "multipv": {
          "type": "integer",
          "minimum": 1
        },
        "reproducible": {
          "type": "boolean"
        },
        "nodes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "R"
          ],
          "properties": {
            "A": {
              "type": "integer",
              "minimum": 1
            },
            "B": {
              "type": "integer",
              "minimum": 1
            },
            "C": {
              "type": "integer",
              "minimum": 1
            },
            "D": {
              "type": "integer",
              "minimum": 1
            },
            "E": {
              "type": "integer",
              "minimum": 1
            },
            "R": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "nodes_searched": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fen",
        "side_to_move",
        "in_check",
        "terminal",
        "eval_white",
        "motifs",
        "positional"
      ],
      "properties": {
        "fen": {
          "type": "string"
        },
        "side_to_move": {
          "$ref": "#/$defs/side"
        },
        "in_check": {
          "type": "boolean"
        },
        "terminal": {
          "enum": [
            "checkmate",
            "stalemate",
            null
          ]
        },
        "eval_white": {
          "oneOf": [
            {
              "$ref": "#/$defs/eval"
            },
            {
              "type": "null"
            }
          ]
        },
        "motifs": {
          "$ref": "#/$defs/motifs"
        },
        "positional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/positional_feature"
          }
        }
      }
    },
    "threats": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "white",
            "black",
            "null_move_reliable",
            "urgency"
          ],
          "properties": {
            "white": {
              "oneOf": [
                {
                  "$ref": "#/$defs/threat"
                },
                {
                  "type": "null"
                }
              ]
            },
            "black": {
              "oneOf": [
                {
                  "$ref": "#/$defs/threat"
                },
                {
                  "type": "null"
                }
              ]
            },
            "null_move_reliable": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "value"
              ],
              "properties": {
                "source": {
                  "const": "rule"
                },
                "value": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "urgency": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "more_urgent",
                "rule"
              ],
              "properties": {
                "source": {
                  "const": "rule"
                },
                "more_urgent": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/side"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rule": {
                  "enum": [
                    "in_check",
                    "quiet",
                    "consequence_class",
                    "counterattack",
                    "parry"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/move"
      }
    },
    "fine_truncated": {
      "type": "boolean"
    },
    "asked_move": {
      "oneOf": [
        {
          "$ref": "#/$defs/move"
        },
        {
          "type": "null"
        }
      ]
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "dataset",
        "current",
        "last_named"
      ],
      "properties": {
        "source": {
          "const": "book"
        },
        "dataset": {
          "type": "string"
        },
        "current": {
          "oneOf": [
            {
              "$ref": "#/$defs/opening_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_named": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "eco",
                "name",
                "ply"
              ],
              "properties": {
                "eco": {
                  "$ref": "#/$defs/eco"
                },
                "name": {
                  "type": "string"
                },
                "ply": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "games": {
      "$ref": "#/$defs/games"
    }
  },
  "$defs": {
    "side": {
      "enum": [
        "white",
        "black"
      ]
    },
    "eco": {
      "type": "string",
      "pattern": "^[A-E][0-9]{2}$"
    },
    "opening_name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eco",
        "name"
      ],
      "properties": {
        "eco": {
          "$ref": "#/$defs/eco"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "san_line": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "es",
        "cp",
        "mate"
      ],
      "properties": {
        "source": {
          "const": "engine"
        },
        "es": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cp": {
          "type": [
            "integer",
            "null"
          ]
        },
        "mate": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "class",
        "mate_in",
        "material",
        "promotes",
        "plies"
      ],
      "properties": {
        "source": {
          "const": "rule"
        },
        "class": {
          "enum": [
            "mate",
            "material",
            "promotion",
            "positional"
          ]
        },
        "mate_in": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "material": {
          "type": "integer"
        },
        "promotes": {
          "type": "boolean"
        },
        "plies": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "side",
        "root_fen",
        "line",
        "consequence",
        "motifs",
        "tactic"
      ],
      "properties": {
        "source": {
          "const": "engine"
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "root_fen": {
          "type": "string"
        },
        "line": {
          "$ref": "#/$defs/san_line"
        },
        "consequence": {
          "$ref": "#/$defs/consequence"
        },
        "motifs": {
          "$ref": "#/$defs/motifs"
        },
        "tactic": {
          "oneOf": [
            {
              "$ref": "#/$defs/tactic"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "san",
        "uci",
        "eval",
        "loss",
        "verdict",
        "in_multipv",
        "gives_check",
        "line",
        "parries_threat",
        "creates_threat",
        "refutation",
        "motifs",
        "tactic",
        "positional"
      ],
      "properties": {
        "source": {
          "const": "engine"
        },
        "san": {
          "type": "string"
        },
        "uci": {
          "type": "string",
          "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
        },
        "eval": {
          "$ref": "#/$defs/eval"
        },
        "loss": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verdict": {
          "enum": [
            "fine",
            "inaccuracy",
            "mistake",
            "blunder"
          ]
        },
        "in_multipv": {
          "type": "boolean"
        },
        "gives_check": {
          "type": "boolean"
        },
        "line": {
          "$ref": "#/$defs/san_line"
        },
        "parries_threat": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "value",
                "test"
              ],
              "properties": {
                "source": {
                  "enum": [
                    "engine",
                    "rule"
                  ]
                },
                "value": {
                  "type": "boolean"
                },
                "test": {
                  "enum": [
                    "searched",
                    "threat_move_illegal",
                    "deferred_by_check"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "creates_threat": {
          "oneOf": [
            {
              "$ref": "#/$defs/threat"
            },
            {
              "type": "null"
            }
          ]
        },
        "refutation": {
          "oneOf": [
            {
              "$ref": "#/$defs/threat"
            },
            {
              "type": "null"
            }
          ]
        },
        "motifs": {
          "$ref": "#/$defs/motifs"
        },
        "tactic": {
          "oneOf": [
            {
              "$ref": "#/$defs/tactic"
            },
            {
              "type": "null"
            }
          ]
        },
        "positional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/positional_change"
          }
        }
      }
    },
    "piece_on_square": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "square",
        "piece"
      ],
      "properties": {
        "square": {
          "type": "string",
          "pattern": "^[a-h][1-8]$"
        },
        "piece": {
          "type": "string",
          "pattern": "^[PNBRQKpnbrqk]$"
        }
      }
    },
    "motif": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "tag",
        "side",
        "ply",
        "actor",
        "targets",
        "gain",
        "threat",
        "contribution"
      ],
      "properties": {
        "source": {
          "const": "rule"
        },
        "tag": {
          "enum": [
            "hanging_piece",
            "pin_absolute",
            "pin_relative",
            "back_rank_weakness",
            "overloaded_defender",
            "trapped_piece",
            "pin_tactical",
            "fork",
            "skewer",
            "discovered_check",
            "discovered_attack",
            "double_check",
            "back_rank_mate",
            "promotion"
          ]
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "ply": {
          "type": "integer",
          "minimum": 0
        },
        "actor": {
          "$ref": "#/$defs/piece_on_square"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/piece_on_square"
          }
        },
        "gain": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "threat": {
          "oneOf": [
            {
              "$ref": "#/$defs/motif_threat"
            },
            {
              "type": "null"
            }
          ]
        },
        "contribution": {
          "enum": [
            "direct",
            "indirect",
            "none",
            null
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tag": {
                "enum": [
                  "hanging_piece",
                  "trapped_piece"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "gain": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "gain": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tag": {
                "const": "pin_tactical"
              }
            }
          },
          "then": {
            "properties": {
              "threat": {
                "$ref": "#/$defs/motif_threat"
              },
              "targets": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "threat": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "motif_threat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "square"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fork",
            "skewer",
            "discovered_check",
            "discovered_attack",
            "double_check",
            "back_rank_mate",
            "promotion",
            "checkmate",
            "capture"
          ]
        },
        "square": {
          "type": "string",
          "pattern": "^[a-h][1-8]$"
        }
      }
    },
    "motifs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/motif"
      }
    },
    "tactic_label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "tag",
        "side",
        "ply",
        "actor",
        "targets"
      ],
      "properties": {
        "source": {
          "const": "rule"
        },
        "tag": {
          "enum": [
            "removal_of_defender"
          ]
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "ply": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "$ref": "#/$defs/piece_on_square"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/piece_on_square"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "tactic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "forced",
        "alternative",
        "margin",
        "is_tactic",
        "labels"
      ],
      "properties": {
        "source": {
          "enum": [
            "engine",
            "rule"
          ]
        },
        "forced": {
          "type": "boolean"
        },
        "alternative": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "san",
                "uci",
                "eval"
              ],
              "properties": {
                "san": {
                  "type": "string"
                },
                "uci": {
                  "type": "string",
                  "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
                },
                "eval": {
                  "$ref": "#/$defs/eval"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "margin": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1,
          "maximum": 1
        },
        "is_tactic": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tactic_label"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "forced": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "source": {
                "const": "rule"
              },
              "alternative": {
                "type": "null"
              },
              "margin": {
                "type": "null"
              },
              "is_tactic": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "source": {
                "const": "engine"
              },
              "alternative": {
                "type": "object"
              },
              "margin": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "is_tactic": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "labels": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "positional_feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "tag",
        "side",
        "pieces",
        "file",
        "value"
      ],
      "properties": {
        "source": {
          "const": "rule"
        },
        "tag": {
          "enum": [
            "isolated_pawn",
            "doubled_pawns",
            "backward_pawn",
            "passed_pawn",
            "connected_passed_pawns",
            "pawn_islands",
            "pawn_chain",
            "castling_kingside",
            "castling_queenside",
            "king_shield_gap",
            "open_file_near_king",
            "half_open_file_near_king",
            "king_zone_attacker",
            "bishop_pair",
            "rook_open_file",
            "rook_half_open_file",
            "rook_seventh",
            "outpost",
            "bad_bishop",
            "mobility_lead",
            "space_lead",
            "development_lead",
            "material_ahead",
            "exchange_up"
          ]
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "pieces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/piece_on_square"
          }
        },
        "file": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-h]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "positional_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "ply",
        "change",
        "holds_at_end",
        "tag",
        "side",
        "pieces",
        "file",
        "value"
      ],
      "properties": {
        "source": {
          "const": "rule"
        },
        "ply": {
          "type": "integer",
          "minimum": 1
        },
        "change": {
          "enum": [
            "appears",
            "disappears"
          ]
        },
        "holds_at_end": {
          "type": "boolean"
        },
        "tag": {
          "enum": [
            "isolated_pawn",
            "doubled_pawns",
            "backward_pawn",
            "passed_pawn",
            "connected_passed_pawns",
            "pawn_islands",
            "pawn_chain",
            "castling_kingside",
            "castling_queenside",
            "king_shield_gap",
            "open_file_near_king",
            "half_open_file_near_king",
            "king_zone_attacker",
            "bishop_pair",
            "rook_open_file",
            "rook_half_open_file",
            "rook_seventh",
            "outpost",
            "bad_bishop",
            "mobility_lead",
            "space_lead",
            "development_lead",
            "material_ahead",
            "exchange_up"
          ]
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "pieces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/piece_on_square"
          }
        },
        "file": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-h]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "games": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "by_source"
      ],
      "properties": {
        "source": {
          "const": "games"
        },
        "by_source": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/game_source"
          }
        }
      }
    },
    "game_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "table",
        "platform",
        "players",
        "months",
        "credit",
        "max_ply",
        "min_games",
        "found",
        "games",
        "white",
        "draws",
        "black",
        "moves"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "players": {
          "type": "string"
        },
        "months": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        },
        "max_ply": {
          "type": "integer",
          "minimum": 1
        },
        "min_games": {
          "type": "integer",
          "minimum": 1
        },
        "found": {
          "type": "boolean"
        },
        "games": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "white": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "draws": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "black": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "moves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/game_move"
          }
        }
      },
      "if": {
        "properties": {
          "found": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
